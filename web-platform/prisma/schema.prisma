// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int              @id @default(autoincrement())
  username        String           @unique
  password        String
  interests       Tag[]            @relation("UserInterests")
  memberships     Membership[]
  interactions    Interaction[]
  recommendations Recommendation[]
  roles                UserRole[]
  eventsCreated        Event[]        @relation("EventCreator")
  announcementsPosted Announcement[] @relation("UserAnnouncements")
  imagesUploaded Image[] @relation("UserImages")
}

model Role {
  id           Int       @id @default(autoincrement())
  name         String    // e.g., "President", "VP of Tech"
  community    Community @relation(fields: [communityId], references: [id])
  communityId  Int
  users        UserRole[]
}

model UserRole {
  id      Int   @id @default(autoincrement())
  user    User  @relation(fields: [userId], references: [id])
  userId  Int
  role    Role  @relation(fields: [roleId], references: [id])
  roleId  Int

  @@unique([userId, roleId])
}


model Community {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  description     String           @default("")
  avatarUrl       String?
  tags            Tag[]            @relation("CommunityTags")
  members         Membership[]
  interactions    Interaction[]
  recommendations Recommendation[]
  roles           Role[]
  events          Event[]
  announcements   Announcement[]
  galleryCategories GalleryCategory[]
}

model Tag {
  id          Int         @id @default(autoincrement())
  name        String      @unique
  users       User[]      @relation("UserInterests")
  communities Community[] @relation("CommunityTags")
  events         Event[]         @relation("EventTags")
  announcements  Announcement[]  @relation("AnnouncementTags")
}

model Membership {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  community   Community @relation(fields: [communityId], references: [id])
  communityId Int
  joinedAt    DateTime  @default(now())

  @@unique([userId, communityId])
}

model Interaction {
  id          Int       @id @default(autoincrement())
  user        User      @relation(fields: [userId], references: [id])
  userId      Int
  community   Community @relation(fields: [communityId], references: [id])
  communityId Int
  type        String    // "view", "click", "rsvp", "join"
  weight      Float     // 0.5,   1.0,    2.0,    3.0
  createdAt   DateTime  @default(now())
}

model Recommendation {
  id           Int       @id @default(autoincrement())
  userId       Int
  communityId  Int
  score        Float
  contentScore Float
  collabScore  Float
  computedAt   DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])
  community    Community @relation(fields: [communityId], references: [id])

  @@unique([userId, communityId])
}

model Event {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  location    String?
  startTime   DateTime
  endTime     DateTime?
  community   Community @relation(fields: [communityId], references: [id])
  communityId Int
  tags        Tag[]     @relation("EventTags")
  createdBy   User      @relation("EventCreator", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime  @default(now())
}

model Announcement {
  id          Int       @id @default(autoincrement())
  title       String
  content     String
  community   Community @relation(fields: [communityId], references: [id])
  communityId Int
  createdBy   User @relation("UserAnnouncements", fields: [createdById], references: [id])
  createdById Int
  createdAt   DateTime  @default(now())
  scheduledAt DateTime?
  tags        Tag[]     @relation("AnnouncementTags")
}

model GalleryCategory {
  id          Int       @id @default(autoincrement())
  name        String    // e.g., "All", "Community", "Campus", "Outreach"
  community   Community @relation(fields: [communityId], references: [id])
  communityId Int
  images      Image[]
}


model Image {
  id            Int             @id @default(autoincrement())
  url           String
  description   String?
  uploadedAt    DateTime        @default(now())
  uploadedBy    User @relation("UserImages", fields: [uploadedById], references: [id])
  uploadedById  Int
  category      GalleryCategory @relation(fields: [categoryId], references: [id])
  categoryId    Int
}